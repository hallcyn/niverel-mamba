# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required only by: python scripts/make_golden_fixture.py --niverel
# The Foundation V3 checkpoint repositories are private.
HF_TOKEN=hf_...

# The Hugging Face account owning the niverel-5b-* repositories.
NIVEREL_HF_ACCOUNT=thibaud-perrin

# Optional: where Hugging Face caches downloads (the V3 checkpoint is ~1.7 GB).
HF_HOME=~/.cache/huggingface
