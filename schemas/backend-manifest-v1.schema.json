{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hallcyn/niverel-mamba/schemas/backend-manifest-v1.schema.json",
  "title": "niverel-mamba binary manifest v1",
  "description": "Describes a set of prebuilt CUDA wheels. The CLI fetches this before any download and verifies each artefact's SHA-256 against it before installing.",
  "type": "object",
  "required": ["schema_version", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "niverel-mamba-binary-manifest-v1" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "source_repository": {
      "type": "string",
      "description": "Repository the extensions were built from."
    },
    "source_commit": {
      "type": ["string", "null"],
      "description": "Exact commit built. Pinned so a build is reproducible."
    },
    "build_workflow": {
      "type": ["string", "null"],
      "description": "The CI workflow and run id that produced these artefacts."
    },
    "certification": {
      "type": "object",
      "description": "Whether these artefacts have been run on real GPU hardware.",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["uncertified", "certified"],
          "description": "'uncertified' artefacts must never be published."
        },
        "report": { "type": ["string", "null"] },
        "architectures_tested": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "package_version", "filename", "sha256",
                     "torch_version", "torch_cuda", "python_tag", "platform",
                     "architectures"],
        "properties": {
          "package": { "type": "string", "examples": ["mamba-ssm", "causal-conv1d"] },
          "package_version": { "type": "string", "examples": ["2.3.2.post1"] },
          "filename": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "torch_version": {
            "type": "string",
            "description": "Torch version this ABI matches. Wheel tags do not encode it, which is exactly why this manifest exists.",
            "examples": ["2.13.0"]
          },
          "torch_cuda": { "type": "string", "examples": ["12.8", "13.0"] },
          "python_tag": { "type": "string", "examples": ["cp312"] },
          "platform": { "type": "string", "examples": ["manylinux_2_28_x86_64"] },
          "cxx11_abi": { "type": "boolean" },
          "architectures": {
            "type": "array",
            "items": { "type": "string", "pattern": "^sm_[0-9]+$" },
            "examples": [["sm_80", "sm_90"]]
          }
        }
      }
    }
  }
}
